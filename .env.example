# =============================================================================
# Local quickstart (copy → .env.local then: pnpm install && pnpm db:migrate && pnpm dev)
#
#   cp .env.example .env.local
#   # edit AUTH_TOKEN_SECRET to any random 32+ char string
#   pnpm install
#   pnpm db:migrate
#   pnpm dev
#   open http://127.0.0.1:3000/login
#
# Sample local accounts (hash values below match these passwords):
#   admin  / admin123
#   viewer / viewer123
#
# Generate your own hashes:
#   node scripts/generate-password-hash.mjs 'your-password'
# In .env.local escape every $ as \$ so dotenv does not expand them.
# =============================================================================

ADMIN_USERNAME=admin
# Local sample: password admin123  (escape $ for dotenv)
ADMIN_PASSWORD_HASH=pbkdf2\$200000\$8c58e3d07e83f771976f206cd10018b0\$0bb5c8fd06d260ff7abebc558fcb8fb85323e553036438786a2b4b9757bc015c
VIEWER_USERNAME=viewer
# Local sample: password viewer123
VIEWER_PASSWORD_HASH=pbkdf2\$200000\$cb626a7bfe2dcef1eb6e06c308829f5e\$f1d295e12327ef612e48b15d4df9967d3bdf6e71a49c1887a48649efccaacd4c
# Any random string ≥ 32 bytes (openssl rand -hex 32)
AUTH_TOKEN_SECRET=local-dev-change-me-to-a-long-random-secret-32b

# -----------------------------------------------------------------------------
# Database (REQUIRED)
#
# Local without Docker (embedded PGlite — recommended for laptop):
#   DATABASE_URL=pglite:.data/pglite
#
# Local/Docker Postgres:
#   DATABASE_URL=postgres://otc_app:PASSWORD@127.0.0.1:5432/otc_desk
# -----------------------------------------------------------------------------
DATABASE_URL=pglite:.data/pglite
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=4

# Optional HMAC secret for market API keys (falls back to AUTH_TOKEN_SECRET):
TETHER_API_KEY_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Outbound HTTP(S) proxy for market providers (server-side only, not browser).
# Optional on local if your network can reach Bonbast/Navasan/Ramzinex.
#   OUTBOUND_HTTPS_PROXY=http://user:pass@proxy.example.com:2053
#   PROXY_HOSTS=bonbast.com,navasan.net,ramzinex.com,ramzinex.ir
# -----------------------------------------------------------------------------
OUTBOUND_HTTPS_PROXY=
PROXY_HOSTS=bonbast.com,navasan.net
